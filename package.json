{
  "name": "titans-forge-crossroads-the-silk-roads",
  "version": "0.3.1",
  "private": true,
  "description": "A local-first human caravan strategy game set on the Silk Roads around AD 200.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vitest run tests/content.test.ts && tsc --noEmit && vite build",
